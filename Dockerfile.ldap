FROM maven:3.9.11-eclipse-temurin-21 AS builder
WORKDIR /build
COPY backend/pom.xml backend/pom.xml
COPY backend/jade-dependencies backend/jade-dependencies
COPY backend/jade-common backend/jade-common
COPY backend/jade-web backend/jade-web
COPY backend/jade-security backend/jade-security
COPY backend/jade-log backend/jade-log
COPY backend/jade-redis backend/jade-redis
COPY backend/jade-oss backend/jade-oss
COPY backend/jade-codegen backend/jade-codegen
COPY backend/jade-spring-bridge backend/jade-spring-bridge
COPY backend/jade-admin backend/jade-admin
COPY backend/jade-demo backend/jade-demo
COPY backend/jade-ldap backend/jade-ldap
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -f backend/pom.xml -B -pl jade-ldap -am package -DskipTests

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /build/backend/jade-ldap/target/quarkus-app/ /app/
EXPOSE 8080 1389 1636
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD curl -fsS http://localhost:8080/q/health || exit 1
ENTRYPOINT ["java", "-jar", "/app/quarkus-run.jar"]

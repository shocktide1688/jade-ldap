# =====================================================
# Jade LDAP · GraalVM Native Image
# Build from the repository root:
#   docker buildx build --platform linux/amd64 -f Dockerfile.ldap .
# =====================================================

# ---------- Stage 1: native builder ----------
FROM m.daocloud.io/quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25 AS builder

ENTRYPOINT []
USER root
WORKDIR /build

RUN microdnf install -y tar gzip findutils \
    && microdnf clean all

ARG MAVEN_VERSION=3.9.11
RUN curl -fsSL -o /tmp/maven.tar.gz \
        https://maven.aliyun.com/repository/public/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    && tar -xzf /tmp/maven.tar.gz -C /opt \
    && ln -s /opt/apache-maven-${MAVEN_VERSION}/bin/mvn /usr/local/bin/mvn \
    && rm /tmp/maven.tar.gz \
    && mvn -version

COPY backend/jade-demo/settings-docker.xml /root/.m2/settings.xml

# Copy POM files first so dependency resolution remains cacheable.
COPY backend/pom.xml ./backend/pom.xml
COPY backend/jade-dependencies/pom.xml ./backend/jade-dependencies/pom.xml
COPY backend/jade-common/pom.xml ./backend/jade-common/pom.xml
COPY backend/jade-web/pom.xml ./backend/jade-web/pom.xml
COPY backend/jade-security/pom.xml ./backend/jade-security/pom.xml
COPY backend/jade-log/pom.xml ./backend/jade-log/pom.xml
COPY backend/jade-redis/pom.xml ./backend/jade-redis/pom.xml
COPY backend/jade-oss/pom.xml ./backend/jade-oss/pom.xml
COPY backend/jade-codegen/pom.xml ./backend/jade-codegen/pom.xml
COPY backend/jade-spring-bridge/pom.xml ./backend/jade-spring-bridge/pom.xml
COPY backend/jade-admin/pom.xml ./backend/jade-admin/pom.xml
COPY backend/jade-demo/pom.xml ./backend/jade-demo/pom.xml
COPY backend/jade-ldap/pom.xml ./backend/jade-ldap/pom.xml

RUN mvn -f backend/pom.xml -B -q -DskipTests -pl jade-ldap -am dependency:go-offline || true

COPY backend ./backend
RUN mvn -f backend/pom.xml -B -DskipTests \
        -pl jade-ldap -am \
        clean install \
    && mvn -f backend/pom.xml -B -DskipTests \
        -pl jade-ldap \
        package \
        -Dnative \
        -Dquarkus.native.enabled=true \
        -Dquarkus.native.container-build=false \
        -Dquarkus.native.march=compatibility

RUN test -x backend/jade-ldap/target/jade-ldap-1.0.0-SNAPSHOT-runner

# ---------- Stage 2: minimal runtime ----------
FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libstdc++6 zlib1g libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/backend/jade-ldap/target/jade-ldap-1.0.0-SNAPSHOT-runner /app/jade-ldap
RUN chmod +x /app/jade-ldap

EXPOSE 8080 1389 1636
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD curl -fsS http://localhost:8080/q/health || exit 1
ENTRYPOINT ["/app/jade-ldap"]
